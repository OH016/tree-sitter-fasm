{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fasm",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_statement"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "_newline": {
      "type": "STRING",
      "value": "\n"
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "label"
        },
        {
          "type": "SYMBOL",
          "name": "macro_definition"
        },
        {
          "type": "SYMBOL",
          "name": "assignment"
        },
        {
          "type": "SYMBOL",
          "name": "data_definition"
        },
        {
          "type": "SYMBOL",
          "name": "instruction"
        }
      ]
    },
    "label": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "macro_definition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "keyword",
          "content": {
            "type": "SYMBOL",
            "name": "macro_keyword"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_operand_list"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_newline"
          }
        },
        {
          "type": "SYMBOL",
          "name": "block"
        }
      ]
    },
    "macro_keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "macro|struc|irp|irps",
        "flags": "i"
      }
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_statement"
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "assignment": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand_list"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "data_definition": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "FIELD",
                "name": "name",
                "content": {
                  "type": "SYMBOL",
                  "name": "identifier"
                }
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "FIELD",
            "name": "directive",
            "content": {
              "type": "SYMBOL",
              "name": "data_directive"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand_list"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "data_directive": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "d[bwdqtpfo]|r[bwdqtpfo]|du|file",
        "flags": "i"
      }
    },
    "instruction": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "mnemonic",
            "content": {
              "type": "SYMBOL",
              "name": "identifier"
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand_list"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_operand_list": {
      "type": "REPEAT1",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_operand"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_operand": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "register"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "float"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "memory"
        },
        {
          "type": "SYMBOL",
          "name": "group"
        },
        {
          "type": "SYMBOL",
          "name": "size_operator"
        },
        {
          "type": "SYMBOL",
          "name": "current_address"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        }
      ]
    },
    "memory": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand"
              },
              {
                "type": "STRING",
                "value": ":"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operand"
              },
              {
                "type": "STRING",
                "value": ":"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "register": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(?:r[abcd]x|e[abcd]x|[abcd]x|[abcd][hl]|r(?:8|9|1[0-5])[bwd]?|[er]?(?:sp|bp|si|di)|[sb]pl|[sd]il|[re]?ip|[cdesfg]s|cr[0-8]|dr[0-7]|tr[0-7]|st(?:[0-7])?|mm[0-7]|[xyz]mm(?:3[01]|[12][0-9]|[0-9]))",
        "flags": "i"
      }
    },
    "size_operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "byte|word|dword|qword|tword|tbyte|fword|pword|dqword|qqword|ptr",
        "flags": "i"
      }
    },
    "current_address": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "$$"
        },
        {
          "type": "STRING",
          "value": "$"
        }
      ]
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[+\\-*/&|~^]|<<|>>|mod|and|or|xor|not|shl|shr|rva|plt",
        "flags": "i"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_.?][A-Za-z0-9_.?@~]*"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9A-Fa-f]+"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][0-9A-Fa-f]*[hH]"
          },
          {
            "type": "PATTERN",
            "value": "0[bB][01]+"
          },
          {
            "type": "PATTERN",
            "value": "[01]+[bB]"
          },
          {
            "type": "PATTERN",
            "value": "[0-7]+[oqOQ]"
          },
          {
            "type": "PATTERN",
            "value": "[0-9]+"
          }
        ]
      }
    },
    "float": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?"
      }
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^\"]"
                  },
                  {
                    "type": "STRING",
                    "value": "\"\""
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^']"
                  },
                  {
                    "type": "STRING",
                    "value": "''"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ";"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "line_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\\"
          },
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "line_continuation"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}